{
  "version": 1,
  "name": "Pine",
  "color": {
    "themes": [
      { "id": "light", "name": "浅色" },
      { "id": "dark", "name": "深色" }
    ],
    "tokens": [
      { "name": "surface", "value": { "light": "#ffffff", "dark": "#17181a" }, "usage": "页面底色。" },
      { "name": "surface-sunken", "value": { "light": "#f5f6f7", "dark": "#111214" }, "usage": "侧栏、分组背景和输入框底色。" },
      { "name": "surface-raised", "value": { "light": "#ffffff", "dark": "#202124" }, "usage": "卡片、菜单和对话框。浅色主题靠 line 与阴影区分层级。" },
      { "name": "line", "value": { "light": "#e6e8eb", "dark": "#2c2e33" }, "usage": "分隔线和卡片描边，只做装饰。" },
      { "name": "border", "value": { "light": "#c9cdd3", "dark": "#474a51" }, "usage": "输入框和可操作控件的边框，对 surface 至少 3:1。" },
      { "name": "ink", "value": { "light": "#15171a", "dark": "#eef0f2" }, "usage": "主要文字。" },
      { "name": "ink-muted", "value": { "light": "#5f6670", "dark": "#a0a6af" }, "usage": "次要文字、说明和元信息。" },
      { "name": "ink-subtle", "value": { "light": "#8a9099", "dark": "#767c85" }, "usage": "占位符和不可用状态。不用于正文。" },
      { "name": "accent", "value": { "light": "#2f6f4f", "dark": "#5fbf8a" }, "usage": "主操作、选中状态和链接。每屏只有一个主操作。" },
      { "name": "accent-hover", "value": { "light": "#255c41", "dark": "#7bd0a0" }, "usage": "主操作的悬停与按下。" },
      { "name": "accent-soft", "value": { "light": "#e6f2eb", "dark": "#1d3a2b" }, "usage": "选中行、强调标签的底色。" },
      { "name": "on-accent", "value": { "light": "#ffffff", "dark": "#0f1f17" }, "usage": "accent 底色上的文字和图标。" },
      { "name": "info", "value": { "light": "#2563eb", "dark": "#6b9cff" }, "usage": "提示信息。" },
      { "name": "info-soft", "value": { "light": "#e8efff", "dark": "#1c2a4a" }, "usage": "提示信息的底色。" },
      { "name": "success", "value": { "light": "#1f8a4c", "dark": "#4cc27e" }, "usage": "完成、通过。" },
      { "name": "success-soft", "value": { "light": "#e5f5ec", "dark": "#183526" }, "usage": "完成状态的底色。" },
      { "name": "warning", "value": { "light": "#b45309", "dark": "#f0a64a" }, "usage": "需要注意但不阻塞。" },
      { "name": "warning-soft", "value": { "light": "#fdf1e3", "dark": "#3d2a12" }, "usage": "注意状态的底色。" },
      { "name": "danger", "value": { "light": "#c2352b", "dark": "#f07167" }, "usage": "错误和破坏性操作。" },
      { "name": "danger-soft", "value": { "light": "#fbe9e7", "dark": "#3d1c1a" }, "usage": "错误状态的底色。" },
      { "name": "focus", "value": { "light": "{accent}", "dark": "{accent}" }, "usage": "键盘焦点环，与 accent 相同。" },
      { "name": "overlay", "value": { "light": "#0f111466", "dark": "#00000099" }, "usage": "对话框背后的遮罩。" }
    ]
  },
  "type": {
    "fonts": [],
    "families": {
      "sans": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
    },
    "groups": [
      {
        "name": "Display",
        "family": "sans",
        "styles": [
          { "name": "display-lg", "fontSize": "40px", "lineHeight": "48px", "fontWeight": 600, "letterSpacing": "-0.8px", "sample": "让团队把事做完", "usage": "落地页主标题。" },
          { "name": "display-md", "fontSize": "32px", "lineHeight": "40px", "fontWeight": 600, "letterSpacing": "-0.5px", "sample": "本周进展", "usage": "页面主标题。" }
        ]
      },
      {
        "name": "Heading",
        "family": "sans",
        "styles": [
          { "name": "heading-lg", "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600, "sample": "Q4 官网改版", "usage": "区块标题、对话框标题。" },
          { "name": "heading-md", "fontSize": "18px", "lineHeight": "26px", "fontWeight": 600, "sample": "进行中的任务", "usage": "卡片标题。" },
          { "name": "heading-sm", "fontSize": "15px", "lineHeight": "22px", "fontWeight": 600, "sample": "负责人", "usage": "分组标题、表单分节。" }
        ]
      },
      {
        "name": "Body",
        "family": "sans",
        "styles": [
          { "name": "body-lg", "fontSize": "16px", "lineHeight": "26px", "fontWeight": 400, "sample": "把需求、讨论和交付放在同一个地方。", "usage": "长段落、落地页正文。" },
          { "name": "body-md", "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400, "sample": "周五前完成首页视觉稿。", "usage": "界面默认正文。" },
          { "name": "body-sm", "fontSize": "12px", "lineHeight": "18px", "fontWeight": 400, "sample": "2 小时前 · 林夏", "usage": "元信息、标签、辅助说明。" }
        ]
      },
      {
        "name": "Mono",
        "family": "mono",
        "styles": [
          { "name": "code", "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400, "sample": "PINE-1284", "usage": "任务编号、代码片段。" }
        ]
      }
    ]
  },
  "spacing": {
    "note": "4 的倍数。相关元素用小间距，不同区块用大间距。",
    "tokens": [
      { "name": "space-1", "value": "4px", "usage": "图标与文字之间。" },
      { "name": "space-2", "value": "8px", "usage": "同组控件之间。" },
      { "name": "space-3", "value": "12px", "usage": "列表行内边距。" },
      { "name": "space-4", "value": "16px", "usage": "卡片内边距、表单项之间。" },
      { "name": "space-5", "value": "20px", "usage": "卡片之间。" },
      { "name": "space-6", "value": "24px", "usage": "对话框内边距。" },
      { "name": "space-8", "value": "32px", "usage": "区块之间。" },
      { "name": "space-10", "value": "40px", "usage": "页面边距。" },
      { "name": "space-12", "value": "48px", "usage": "落地页区块之间。" },
      { "name": "space-16", "value": "64px", "usage": "落地页大区块之间。" }
    ]
  },
  "radius": {
    "note": "控件 6–10px，容器 14–20px，标签和头像用全圆角。",
    "tokens": [
      { "name": "radius-xs", "value": "4px", "usage": "复选框、小标签。" },
      { "name": "radius-sm", "value": "6px", "usage": "小按钮。" },
      { "name": "radius-md", "value": "10px", "usage": "按钮、输入框。" },
      { "name": "radius-lg", "value": "14px", "usage": "卡片。" },
      { "name": "radius-xl", "value": "20px", "usage": "对话框、大面板。" },
      { "name": "radius-full", "value": "999px", "usage": "标签、头像、开关。" }
    ]
  },
  "shadow": {
    "note": "阴影只表达层级，不做装饰。",
    "tokens": [
      { "name": "shadow-sm", "value": { "light": "0 1px 2px rgba(15, 17, 20, 0.06)", "dark": "0 1px 2px rgba(0, 0, 0, 0.4)" }, "usage": "卡片。" },
      { "name": "shadow-md", "value": { "light": "0 4px 16px rgba(15, 17, 20, 0.08)", "dark": "0 4px 16px rgba(0, 0, 0, 0.5)" }, "usage": "菜单、浮层。" },
      { "name": "shadow-lg", "value": { "light": "0 16px 48px rgba(15, 17, 20, 0.16)", "dark": "0 16px 48px rgba(0, 0, 0, 0.6)" }, "usage": "对话框。" }
    ]
  },
  "duration": {
    "note": "状态变化用 fast，面板进出用 normal。",
    "tokens": [
      { "name": "duration-fast", "value": "120ms", "usage": "悬停、按下。" },
      { "name": "duration-normal", "value": "200ms", "usage": "展开、对话框出现。" }
    ]
  },
  "zIndex": {
    "tokens": [
      { "name": "z-dropdown", "value": "20", "usage": "下拉菜单。" },
      { "name": "z-dialog", "value": "40", "usage": "对话框与遮罩。" },
      { "name": "z-toast", "value": "60", "usage": "全局提示。" }
    ]
  }
