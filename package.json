{
  "name": "@vontean/minedesign",
  "version": "0.1.2-dev.0",
  "type": "module",
  "description": "Independent Codex design and design-system plugin",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:editors": "node apps/design-editor/build.mjs && node apps/design-system-editor/build.mjs",
    "build": "npm run build:icons && npm run build:editors && node scripts/build.mjs",
    "start": "node dist/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:local": "npm run install:dev",
    "build:icons": "node scripts/build-brand-icons.mjs",
    "prepack": "npm run build",
    "test:modules": "vitest run packages --maxWorkers=2",
    "verify:equivalence": "node scripts/verify-equivalence.mjs",
    "check:i18n": "tsc -p tsconfig.i18n.json && node scripts/check-i18n.mjs",
    "export:i18n": "node scripts/export-i18n.mjs",
    "install:dev": "node scripts/install-local.mjs --dev"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "lucide": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "bin": {
    "mdn": "bin/mdn.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/install-local.mjs",
    ".codex-plugin/plugin.json",
    "assets/brand/",
    "assets/illustrations/",
    "assets/tokens.css",
    "assets/editor-theme.css",
    "skills/",
    "examples/",
    "DESIGN.md",
    "CONTEXT.md",
    "PRD.md",
    "AGENTS.md",
    "ARCHITECTURE.md",
    "docs/",
    "FORK.md",
    "apps/design-editor/dist/",
    "apps/design-system-editor/dist/"
  ],
  "license": "SEE LICENSE IN FORK.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vontean/MineDesign.git"
  },
  "homepage": "https://github.com/Vontean/MineDesign#readme",
  "bugs": {
    "url": "https://github.com/Vontean/MineDesign/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
