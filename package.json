{
  "name": "minedesign",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "description": "Local experimental Codex design plugin adapted from BaoCut",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "vendor/baocut/apps/*",
    "vendor/baocut/packages/*",
    "packages/*"
  ],
  "scripts": {
    "build:editors": "node vendor/baocut/apps/design-editor/build.mjs && node vendor/baocut/apps/design-system-editor/build.mjs",
    "build": "npm run build:icons && npm run build:editors && node scripts/build.mjs",
    "start": "node dist/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:local": "node scripts/install-local.mjs",
    "build:icons": "node scripts/build-brand-icons.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "lucide": "1.61.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "bin": {
    "mdn": "bin/mdn.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/install-local.mjs",
    ".codex-plugin/plugin.json",
    "assets/brand/",
    "assets/illustrations/",
    "assets/tokens.css",
    "assets/editor-theme.css",
    "skills/",
    "examples/",
    "DESIGN.md",
    "CONTEXT.md",
    "PRD.md",
    "vendor/UPSTREAM.md",
    "vendor/baocut/LICENSE",
    "vendor/baocut/THIRD_PARTY_NOTICES.md",
    "vendor/baocut/packages/design-runtime/README.md",
    "vendor/baocut/packages/design-system-runtime/README.md",
    "vendor/baocut/apps/design-editor/dist/",
    "vendor/baocut/apps/design-system-editor/dist/"
  ]
}
